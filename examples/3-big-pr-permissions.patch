@@ -1,8 +1,9 @@
 import { User, Resource } from "./types";
 
 export type Action = "read" | "write" | "admin";
+export type Scope = "own" | "team" | "all";
 
 const ROLE_ACTIONS: Record<string, Action[]> = {
   viewer: ["read"],
   editor: ["read", "write"],
   admin: ["read", "write", "admin"],
@@ -20,15 +21,16 @@ export function roleAllows(role: string, action: Action): boolean {
   return (ROLE_ACTIONS[role] ?? []).includes(action);
 }
 
 export function can(user: User, action: Action, resource: Resource): boolean {
-  if (!user.active) return false;
-  if (resource.ownerId === user.id) return true;
-  if (resource.teamId && user.teams.includes(resource.teamId)) {
-    return roleAllows(user.teamRole(resource.teamId), action);
-  }
-  return roleAllows(user.globalRole, action);
+  if (!user.active) return false;
+  const scope: Scope = resource.teamId ? "team" : "all";
+  if (resource.ownerId === user.id || scope === "all") return true;
+  if (user.teams.includes(resource.teamId!)) {
+    return roleAllows(user.teamRole(resource.teamId!), action);
+  }
+  return roleAllows(user.globalRole, action);
 }
 
 export function assertCan(user: User, action: Action, resource: Resource): void {
   if (!can(user, action, resource)) throw new ForbiddenError(action, resource.id);
 }
@@ -40,4 +43,8 @@ export function assertCan(user: User, action: Action, resource: Resource): void
 
 export function describe(user: User): string {
-  return `${user.email} (${user.globalRole})`;
+  return `${user.email} (${user.globalRole}, ${user.teams.length} teams)`;
 }
+
+export function isAdmin(user: User): boolean {
+  return roleAllows(user.globalRole, "admin");
+}
