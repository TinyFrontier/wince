diff --git a/src/ui/PageSizePicker.tsx b/src/ui/PageSizePicker.tsx
new file mode 100644
index 0000000..ddeeff0
--- /dev/null
+++ b/src/ui/PageSizePicker.tsx
@@ -0,0 +1,12 @@
+export function PageSizePicker({ value, onChange }: { value: number; onChange: (n: number) => void }) {
+  return (
+    <select value={value} onChange={(e) => onChange(Number(e.target.value))}>
+      {[25, 50, 100].map((n) => (
+        <option key={n} value={n}>
+          {n} per page
+        </option>
+      ))}
+    </select>
+  );
+}
+
